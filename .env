# The site's public address. Social cards must point at an absolute URL, so set
# this to the real domain before sharing the link — WhatsApp, iMessage, X and
# Facebook all resolve og:image against it.
#
# Vercel exposes the deployment domain, but it is not available at build time in
# every setup, so it is pinned here deliberately.
VITE_SITE_URL=https://ini-groomsmen-invitation.vercel.app
